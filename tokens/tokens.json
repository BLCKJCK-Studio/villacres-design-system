      "weight": 900,
      "style": "italic",
      "uppercase": true,
      "tracking": "-0.01em",
      "leading": 0.95
    },
    "label": {
      "weight": "500–600",
      "style": "italic",
      "uppercase": true,
      "tracking": "0.06em",
      "leading": 1.1
    },
    "body": {
      "weight": "400–500",
      "style": "normal",
      "uppercase": false,
      "tracking": "0",
      "leading": 1.45
    },
    "figure": {
      "weight": 900,
      "style": "italic",
      "note": "'62-1' siempre Black Italic, cifras tabulares"
    }
  },
